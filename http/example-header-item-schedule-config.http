@host = http://localhost:8080
@service = {{host}}/odata/v4/DataImportService
@basic_auth = Basic c3lzdGVtOg==

@processor_version = 1.0.0-SNAPSHOT

@noop_artifact_id = 7a9d4401-219d-4f44-a52f-8cfa3d0c1001
@table01_artifact_id = 7a9d4401-219d-4f44-a52f-8cfa3d0c1002
@header_item_schedule_artifact_id = 7a9d4401-219d-4f44-a52f-8cfa3d0c1003

@noop_entry_class = customer.batchimportcat.processor.noop.NoopBatchImportProcessor
@table01_entry_class = customer.batchimportcat.processor.example.table01.ExampleTable01BatchImportProcessor
@header_item_schedule_entry_class = customer.batchimportcat.processor.example.headeritemschedule.ExampleHeaderItemScheduleBatchImportProcessor

@config_id = 3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a1001
@noop_config_id = 3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a1002
@table01_config_id = 3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a1003

@header_structure_id = 3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a2001
@item_structure_id = 3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a2002
@schedule_structure_id = 3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a2003
@noop_structure_id = 3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a2004
@table01_structure_id = 3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a2005

# This file serves two purposes:
# 1. The first POST block is still the default local HTTP seed for HttpRequestSeedRunner.
# 2. The remaining blocks are manual maintenance samples for ProcessorArtifact and BatchImportConfig.
#
# Build processor-plugin JARs before uploading them to ProcessorArtifact.MediaContent:
#   mvn -q -f pom.xml -pl processor-plugin-noop,processor-plugin-example-table01,processor-plugin-example-header-item-schedule -am package
#
# Artifact upload paths below assume the default module target paths generated by the command above.
# If the project revision changes, update both the MediaFileName field and the binary upload path.


###
# Create ProcessorArtifact metadata for NOOP
POST {{service}}/ProcessorArtifact
Authorization: {{basic_auth}}
Content-Type: application/json
Accept: application/json
Prefer: return=representation

{
  "ID": "{{noop_artifact_id}}",
  "IsActiveEntity": true,
  "ProcessKey": "NOOP",
  "Version": "{{processor_version}}",
  "Description": "NOOP sample processor plugin",
  "ArtifactStorageType": "DB_MEDIA",
  "MediaMimeType": "application/java-archive",
  "MediaFileName": "batchimportcat-processor-plugin-noop-{{processor_version}}.jar",
  "EntryPointClass": "{{noop_entry_class}}",
  "Enabled": true
}

###
# Upload NOOP processor JAR to ProcessorArtifact.MediaContent
PUT {{service}}/ProcessorArtifact(ID={{noop_artifact_id}},IsActiveEntity=true)/MediaContent
Authorization: {{basic_auth}}
Content-Type: application/java-archive

< ../processor-plugin-noop/target/batchimportcat-processor-plugin-noop-1.0.0-SNAPSHOT.jar

###
# Create ProcessorArtifact metadata for EXAMPLE_TABLE01
POST {{service}}/ProcessorArtifact
Authorization: {{basic_auth}}
Content-Type: application/json
Accept: application/json
Prefer: return=representation

{
  "ID": "{{table01_artifact_id}}",
  "IsActiveEntity": true,
  "ProcessKey": "EXAMPLE_TABLE01",
  "Version": "{{processor_version}}",
  "Description": "Example processor that writes root rows into ExampleService.ZZTable01",
  "ArtifactStorageType": "DB_MEDIA",
  "MediaMimeType": "application/java-archive",
  "MediaFileName": "batchimportcat-processor-plugin-example-table01-{{processor_version}}.jar",
  "EntryPointClass": "{{table01_entry_class}}",
  "Enabled": true
}

###
# Upload EXAMPLE_TABLE01 processor JAR to ProcessorArtifact.MediaContent
PUT {{service}}/ProcessorArtifact(ID={{table01_artifact_id}},IsActiveEntity=true)/MediaContent
Authorization: {{basic_auth}}
Content-Type: application/java-archive

< ../processor-plugin-example-table01/target/batchimportcat-processor-plugin-example-table01-1.0.0-SNAPSHOT.jar

###
# Create ProcessorArtifact metadata for EXAMPLE_HEADER_ITEM_SCHEDULE
POST {{service}}/ProcessorArtifact
Authorization: {{basic_auth}}
Content-Type: application/json
Accept: application/json
Prefer: return=representation

{
  "ID": "{{header_item_schedule_artifact_id}}",
  "IsActiveEntity": true,
  "ProcessKey": "EXAMPLE_HEADER_ITEM_SCHEDULE",
  "Version": "{{processor_version}}",
  "Description": "Example multi-level processor for Header -> Item -> Schedule payloads",
  "ArtifactStorageType": "DB_MEDIA",
  "MediaMimeType": "application/java-archive",
  "MediaFileName": "batchimportcat-processor-plugin-example-header-item-schedule-{{processor_version}}.jar",
  "EntryPointClass": "{{header_item_schedule_entry_class}}",
  "Enabled": true
}

###
# Upload EXAMPLE_HEADER_ITEM_SCHEDULE processor JAR to ProcessorArtifact.MediaContent
PUT {{service}}/ProcessorArtifact(ID={{header_item_schedule_artifact_id}},IsActiveEntity=true)/MediaContent
Authorization: {{basic_auth}}
Content-Type: application/java-archive

< ../processor-plugin-example-header-item-schedule/target/batchimportcat-processor-plugin-example-header-item-schedule-1.0.0-SNAPSHOT.jar

###
# Verify all maintained ProcessorArtifact rows
GET {{service}}/ProcessorArtifact?$select=ID,ProcessKey,Version,Description,Enabled,EntryPointClass,ArtifactChecksum,MediaSize&$orderby=ProcessKey,Version
Authorization: {{basic_auth}}
Accept: application/json


###
# Seed config: create one active configuration for EXAMPLE_HEADER_ITEM_SCHEDULE
# Expected workbook layout after template generation:
# Sheet Header   : HeaderId | DocumentNo | HeaderName
# Sheet Item     : HeaderId | ItemNo | MaterialCode | Quantity
# Sheet Schedule : HeaderId | ItemNo | ScheduleLine | DeliveryDate | Quantity
#
# Notes:
# 1. SheetName must stay Header / Item / Schedule, because the processor reads child tables by these names.
# 2. Item rows link to Header by Item.HeaderId -> Header.HeaderId.
# 3. Schedule rows link to Item by Schedule.HeaderId -> Item.HeaderId and Schedule.ItemNo -> Item.ItemNo.
# 4. This request bypasses draft flow intentionally by sending IsActiveEntity=true, which CAP supports for draft-enabled entities.
# 5. If your local service is exposed on another port, change @host only.
# 6. Basic auth header below is for user `system` with empty password, that is `system:`.
POST {{service}}/BatchImportConfig
Authorization: {{basic_auth}}
Content-Type: application/json
Accept: application/json
Prefer: return=representation

{
  "ID": "{{config_id}}",
  "IsActiveEntity": true,
  "Object": "EX_HIS_TEST",
  "ObjectName": "Example Header Item Schedule Test Config",
  "ProcessKey": "EXAMPLE_HEADER_ITEM_SCHEDULE",
  "ImplementedByClass": "{{header_item_schedule_entry_class}}",
  "StructName": "Header",
  "SheetName": "Header",
  "StartLine": 1,
  "StartColumn": "A",
  "to_Structures": [
    {
      "ID": "{{header_structure_id}}",
      "ConfigUUID": "{{config_id}}",
      "RootNode": true,
      "SheetName": "Header",
      "StartLine": 1,
      "StartColumn": "A",
      "HasFieldnameLine": true,
      "HasDescLine": true,
      "to_Fields": [
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3001",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{header_structure_id}}",
          "FieldName": "HeaderId",
          "FieldDescription": "Header ID",
          "IsKeyField": true,
          "Sequence": 10,
          "IsForeignField": false,
          "FieldLength": 40,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3002",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{header_structure_id}}",
          "FieldName": "DocumentNo",
          "FieldDescription": "Document Number",
          "IsKeyField": false,
          "Sequence": 20,
          "IsForeignField": false,
          "FieldLength": 40,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3003",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{header_structure_id}}",
          "FieldName": "HeaderName",
          "FieldDescription": "Header Name",
          "IsKeyField": false,
          "Sequence": 30,
          "IsForeignField": false,
          "FieldLength": 100,
          "FieldType": "STRING"
        }
      ]
    },
    {
      "ID": "{{item_structure_id}}",
      "ConfigUUID": "{{config_id}}",
      "RootNode": false,
      "SheetName": "Item",
      "SheetNameUp": "Header",
      "StartLine": 1,
      "StartColumn": "A",
      "HasFieldnameLine": true,
      "HasDescLine": true,
      "to_Fields": [
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3011",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{item_structure_id}}",
          "FieldName": "HeaderId",
          "FieldDescription": "Header ID",
          "IsKeyField": true,
          "Sequence": 10,
          "IsForeignField": true,
          "ForeignField": "HeaderId",
          "FieldLength": 40,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3012",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{item_structure_id}}",
          "FieldName": "ItemNo",
          "FieldDescription": "Item Number",
          "IsKeyField": true,
          "Sequence": 20,
          "IsForeignField": false,
          "FieldLength": 20,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3013",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{item_structure_id}}",
          "FieldName": "MaterialCode",
          "FieldDescription": "Material Code",
          "IsKeyField": false,
          "Sequence": 30,
          "IsForeignField": false,
          "FieldLength": 40,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3014",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{item_structure_id}}",
          "FieldName": "Quantity",
          "FieldDescription": "Item Quantity",
          "IsKeyField": false,
          "Sequence": 40,
          "IsForeignField": false,
          "FieldLength": 13,
          "FieldType": "DECIMAL",
          "FieldDecimal": 3
        }
      ]
    },
    {
      "ID": "{{schedule_structure_id}}",
      "ConfigUUID": "{{config_id}}",
      "RootNode": false,
      "SheetName": "Schedule",
      "SheetNameUp": "Item",
      "StartLine": 1,
      "StartColumn": "A",
      "HasFieldnameLine": true,
      "HasDescLine": true,
      "to_Fields": [
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3021",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{schedule_structure_id}}",
          "FieldName": "HeaderId",
          "FieldDescription": "Header ID",
          "IsKeyField": true,
          "Sequence": 10,
          "IsForeignField": true,
          "ForeignField": "HeaderId",
          "FieldLength": 40,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3022",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{schedule_structure_id}}",
          "FieldName": "ItemNo",
          "FieldDescription": "Item Number",
          "IsKeyField": true,
          "Sequence": 20,
          "IsForeignField": true,
          "ForeignField": "ItemNo",
          "FieldLength": 20,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3023",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{schedule_structure_id}}",
          "FieldName": "ScheduleLine",
          "FieldDescription": "Schedule Line",
          "IsKeyField": true,
          "Sequence": 30,
          "IsForeignField": false,
          "FieldLength": 10,
          "FieldType": "INTEGER"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3024",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{schedule_structure_id}}",
          "FieldName": "DeliveryDate",
          "FieldDescription": "Delivery Date",
          "IsKeyField": false,
          "Sequence": 40,
          "IsForeignField": false,
          "FieldLength": 10,
          "FieldType": "DATE"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3025",
          "ConfigUUID": "{{config_id}}",
          "StructureUUID": "{{schedule_structure_id}}",
          "FieldName": "Quantity",
          "FieldDescription": "Schedule Quantity",
          "IsKeyField": false,
          "Sequence": 50,
          "IsForeignField": false,
          "FieldLength": 13,
          "FieldType": "DECIMAL",
          "FieldDecimal": 3
        }
      ]
    }
  ]
}

###
# Verify the seeded EXAMPLE_HEADER_ITEM_SCHEDULE configuration
GET {{service}}/BatchImportConfig(ID={{config_id}},IsActiveEntity=true)?$expand=to_Structures($orderby=SheetName;$expand=to_Fields($orderby=Sequence))
Authorization: {{basic_auth}}
Accept: application/json




###
# Create BatchImportConfig for NOOP
# The NOOP processor accepts any root structure and only reports success messages.
POST {{service}}/BatchImportConfig
Authorization: {{basic_auth}}
Content-Type: application/json
Accept: application/json
Prefer: return=representation

{
  "ID": "{{noop_config_id}}",
  "IsActiveEntity": true,
  "Object": "EX_NOOP_TEST",
  "ObjectName": "Example NOOP Test Config",
  "ProcessKey": "NOOP",
  "ImplementedByClass": "{{noop_entry_class}}",
  "StructName": "NoopRoot",
  "SheetName": "NoopRoot",
  "StartLine": 1,
  "StartColumn": "A",
  "to_Structures": [
    {
      "ID": "{{noop_structure_id}}",
      "ConfigUUID": "{{noop_config_id}}",
      "RootNode": true,
      "SheetName": "NoopRoot",
      "StartLine": 1,
      "StartColumn": "A",
      "HasFieldnameLine": true,
      "HasDescLine": true,
      "to_Fields": [
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3031",
          "ConfigUUID": "{{noop_config_id}}",
          "StructureUUID": "{{noop_structure_id}}",
          "FieldName": "RecordId",
          "FieldDescription": "Record ID",
          "IsKeyField": true,
          "Sequence": 10,
          "IsForeignField": false,
          "FieldLength": 40,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3032",
          "ConfigUUID": "{{noop_config_id}}",
          "StructureUUID": "{{noop_structure_id}}",
          "FieldName": "Description",
          "FieldDescription": "Description",
          "IsKeyField": false,
          "Sequence": 20,
          "IsForeignField": false,
          "FieldLength": 255,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3033",
          "ConfigUUID": "{{noop_config_id}}",
          "StructureUUID": "{{noop_structure_id}}",
          "FieldName": "Amount",
          "FieldDescription": "Amount",
          "IsKeyField": false,
          "Sequence": 30,
          "IsForeignField": false,
