###
# Create BatchImportConfig for EXAMPLE_TABLE01
# Field names must stay field_str01 / field_str02 / field_dec_01 because the processor reads them by exact key.
POST {{service}}/BatchImportConfig
Authorization: {{basic_auth}}
Content-Type: application/json
Accept: application/json
Prefer: return=representation

{
  "ID": "{{table01_config_id}}",
  "IsActiveEntity": true,
  "Object": "EX_TABLE01_TEST",
  "ObjectName": "Example Table01 Test Config",
  "ProcessKey": "EXAMPLE_TABLE01",
  "ImplementedByClass": "{{table01_entry_class}}",
  "StructName": "ZZTable01",
  "SheetName": "ZZTable01",
  "StartLine": 1,
  "StartColumn": "A",
  "to_Structures": [
    {
      "ID": "{{table01_structure_id}}",
      "ConfigUUID": "{{table01_config_id}}",
      "RootNode": true,
      "SheetName": "ZZTable01",
      "StartLine": 1,
      "StartColumn": "A",
      "HasFieldnameLine": true,
      "HasDescLine": true,
      "to_Fields": [
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3041",
          "ConfigUUID": "{{table01_config_id}}",
          "StructureUUID": "{{table01_structure_id}}",
          "FieldName": "field_str01",
          "FieldDescription": "Field String 01",
          "IsKeyField": true,
          "Sequence": 10,
          "IsForeignField": false,
          "FieldLength": 10,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3042",
          "ConfigUUID": "{{table01_config_id}}",
          "StructureUUID": "{{table01_structure_id}}",
          "FieldName": "field_str02",
          "FieldDescription": "Field String 02",
          "IsKeyField": false,
          "Sequence": 20,
          "IsForeignField": false,
          "FieldLength": 20,
          "FieldType": "STRING"
        },
        {
          "ID": "3e8a5cb7-7bf3-4f73-9f87-9e5f7d8a3043",
