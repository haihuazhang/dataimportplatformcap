###
# # List all three sample configurations together
# GET {{service}}/BatchImportConfig?$select=ID,Object,ObjectName,ProcessKey,ImplementedByClass&$filter=ProcessKey eq 'NOOP' or ProcessKey eq 'EXAMPLE_TABLE01' or ProcessKey eq 'EXAMPLE_HEADER_ITEM_SCHEDULE'&$orderby=ProcessKey
# Authorization: {{basic_auth}}
# Accept: application/json
