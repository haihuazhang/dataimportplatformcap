{
    "name": "zzdtimplog",
    "version": "0.0.1",
    "description": "Display Log of Import Files",
    "keywords": [
        "ui5",
        "openui5",
        "sapui5"
    ],
    "main": "webapp/index.html",
    "scripts": {
        "build": "ui5 build --config=ui5.yaml --clean-dest --dest dist",
        "build:mta": "npm run build && cp xs-app.json dist/xs-app.json && cd dist && bestzip ../zzdtimplog.zip *",
        "deploy-config": "npx -p @sap/ux-ui5-tooling fiori add deploy-config cf"
    },
    "devDependencies": {
        "@ui5/cli": "^4",
        "bestzip": "^2.2.1"
    }
}
